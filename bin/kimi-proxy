#!/bin/bash
# =============================================================================
# Kimi Proxy Middleware MCP - Commande principale
# =============================================================================

set -e

# Couleurs
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Répertoire du projet
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(dirname "$SCRIPT_DIR")"
VENV_DIR="$PROJECT_DIR/venv"
PID_FILE="$PROJECT_DIR/.server.pid"

# =============================================================================
# Fonctions utilitaires
# =============================================================================

show_help() {
    cat << EOF
Kimi Proxy Middleware MCP - Passerelle OpenAI-compatible et gateway MCP

Usage: kimi-proxy <command> [options]

Commandes:
    start       Démarre le serveur
    stop        Arrête le serveur
    restart     Redémarre le serveur
    status      Affiche le statut du serveur
    logs        Affiche les logs du serveur
    test        Lance les tests
    shell       Ouvre un shell Python avec l'environnement chargé
    help        Affiche cette aide

Options pour start:
    --host      Host à écouter (défaut: 127.0.0.1)
    --port      Port à écouter (défaut: 8000)
    --reload    Active le reload automatique

Exemples:
    kimi-proxy start              # Démarre sur le port 8000
    kimi-proxy start --port 9000  # Démarre sur le port 9000
    kimi-proxy status             # Vérifie si le serveur tourne

EOF
}

log_info() {
    echo -e "${BLUE}ℹ️  $1${NC}"
}

log_success() {
    echo -e "${GREEN}✅ $1${NC}"
}

log_warning() {
    echo -e "${YELLOW}⚠️  $1${NC}"
}

log_error() {
    echo -e "${RED}❌ $1${NC}"
}

systemd_service_active() {
    command -v systemctl >/dev/null 2>&1 \
        && systemctl --user is-active --quiet kimi-proxy 2>/dev/null
}

# =============================================================================
# Commandes
# =============================================================================

cmd_start() {
    local host="127.0.0.1"
    local port="8000"
    local -a reload_args=()
    
    # Parse les arguments
    while [[ $# -gt 0 ]]; do
        case $1 in
            --host)
                host="$2"
                shift 2
                ;;
            --port)
                port="$2"
                shift 2
                ;;
            --reload)
                # Surveille uniquement src/ : évite que watchfiles traverse
                # des artefacts de test ou des liens symboliques hors workspace.
                reload_args+=(--reload --reload-dir "$PROJECT_DIR/src")
                shift
                ;;
            *)
                shift
                ;;
        esac
    done
    
    # Vérifie si le service systemd gère déjà le serveur
    if systemd_service_active; then
        log_warning "Le service systemd kimi-proxy est déjà actif"
        log_info "Utilisez 'systemctl --user restart kimi-proxy' ou 'kimi-proxy restart'"
        exit 1
    fi

    # Vérifie si déjà en cours d'exécution
    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE")
        if ps -p "$pid" > /dev/null 2>&1; then
            log_warning "Le serveur tourne déjà (PID: $pid)"
            log_info "Utilisez 'kimi-proxy restart' pour redémarrer"
            exit 1
        else
            rm -f "$PID_FILE"
        fi
    fi
    
    # Vérifie l'environnement virtuel
    if [ ! -d "$VENV_DIR" ]; then
        log_warning "Environnement virtuel non trouvé, création..."
        python3 -m venv "$VENV_DIR"
        source "$VENV_DIR/bin/activate"
        pip install -q -r "$PROJECT_DIR/requirements.txt"
    else
        source "$VENV_DIR/bin/activate"
    fi
    
    # Chargement des variables d'environnement depuis .env (Bash pur, sans xargs)
    if [ -f ".env" ]; then
        log_info "Chargement des variables d'environnement depuis .env..."
        while IFS='=' read -r key value || [ -n "$key" ]; do
            # Supprime les espaces autour de la clé
            key="${key#"${key%%[![:space:]]*}"}"
            key="${key%"${key##*[![:space:]]}"}"
            [[ -z "$key" || "$key" =~ ^# ]] && continue

            # Accepte la syntaxe "export KEY=value"
            key="${key#export }"
            key="${key#"${key%%[![:space:]]*}"}"
            [[ "$key" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue

            # Supprime le CR éventuel puis les espaces autour de la valeur
            value="${value%$'\r'}"
            value="${value#"${value%%[![:space:]]*}"}"
            value="${value%"${value##*[![:space:]]}"}"

            # Retire uniquement les guillemets englobants
            value="${value#\"}"; value="${value%\"}"
            value="${value#\'}"; value="${value%\'}"

            export "$key=$value"
        done < .env
    else
        log_warning "Fichier .env non trouvé"
    fi
    
    log_info "Démarrage du serveur sur $host:$port..."
    
    # Démarre le serveur en arrière-plan
    cd "$PROJECT_DIR"
    PYTHONPATH="$PROJECT_DIR/src:$PYTHONPATH" \
        uvicorn kimi_proxy.main:app \
        --host "$host" \
        --port "$port" \
        "${reload_args[@]}" \
        > "$PROJECT_DIR/server.log" 2>&1 &
    
    local server_pid=$!
    echo $server_pid > "$PID_FILE"
    echo "$port" > "$PROJECT_DIR/.server.port"

    # Attend que le serveur démarre
    sleep 2
    
    if ps -p "$server_pid" > /dev/null 2>&1; then
        log_success "Serveur démarré (PID: $server_pid)"
        log_info "API: http://localhost:$port"
        log_info "Logs: tail -f $PROJECT_DIR/server.log"
        
        # Démarre les serveurs MCP Phase 3 automatiquement
        log_info "Démarrage des serveurs MCP Phase 3..."
        if [ -f "$PROJECT_DIR/scripts/start-mcp-servers.sh" ]; then
            "$PROJECT_DIR/scripts/start-mcp-servers.sh" start > /dev/null 2>&1 &
            sleep 2
            log_success "Serveurs MCP démarrés"
        else
            log_warning "Script start-mcp-servers.sh non trouvé"
        fi
    else
        log_error "Échec du démarrage du serveur"
        rm -f "$PID_FILE"
        exit 1
    fi
}

cmd_stop() {
    if systemd_service_active; then
        log_info "Arrêt du service systemd kimi-proxy..."
        systemctl --user stop kimi-proxy
        rm -f "$PID_FILE" "$PROJECT_DIR/.server.port"
        log_success "Service systemd arrêté"
        return
    fi

    if [ ! -f "$PID_FILE" ]; then
        log_warning "Aucun serveur en cours d'exécution"
        exit 0
    fi
    
    local pid=$(cat "$PID_FILE")
    
    if ps -p "$pid" > /dev/null 2>&1; then
        log_info "Arrêt du serveur (PID: $pid)..."
        kill "$pid" 2>/dev/null || true
        
        # Attend que le processus s'arrête
        local count=0
        while ps -p "$pid" > /dev/null 2>&1 && [ $count -lt 10 ]; do
            sleep 1
            ((count++))
        done
        
        if ps -p "$pid" > /dev/null 2>&1; then
            log_warning "Forçage de l'arrêt..."
            kill -9 "$pid" 2>/dev/null || true
        fi
        
        log_success "Serveur arrêté"
    else
        log_warning "Le serveur ne tourne plus"
    fi
    
    rm -f "$PID_FILE" "$PROJECT_DIR/.server.port"
}

cmd_restart() {
    if systemd_service_active; then
        log_info "Redémarrage du service systemd kimi-proxy..."
        systemctl --user restart kimi-proxy
        log_success "Service systemd redémarré"
        return
    fi

    log_info "Redémarrage du serveur..."
    cmd_stop
    sleep 1
    cmd_start "$@"
}

cmd_status() {
    if systemd_service_active; then
        local port="${KIMI_PORT:-8000}"
        log_success "Service systemd kimi-proxy actif"
        if curl -s "http://localhost:$port/health" > /dev/null 2>&1; then
            log_success "API accessible sur http://localhost:$port"
        else
            log_warning "API ne répond pas encore sur le port $port"
        fi
        return
    fi

    if [ -f "$PID_FILE" ]; then
        local pid=$(cat "$PID_FILE")
        local port="${KIMI_PORT:-8000}"
        if [ -f "$PROJECT_DIR/.server.port" ]; then
            port=$(cat "$PROJECT_DIR/.server.port")
        fi
        if ps -p "$pid" > /dev/null 2>&1; then
            log_success "Serveur actif (PID: $pid)"
            
            # Vérifie si le port répond
            if curl -s "http://localhost:$port/health" > /dev/null 2>&1; then
                log_success "API accessible sur http://localhost:$port"
            else
                log_warning "API ne répond pas encore sur le port $port"
            fi
        else
            log_error "Le serveur ne tourne plus (PID fantôme: $pid)"
            rm -f "$PID_FILE" "$PROJECT_DIR/.server.port"
        fi
    else
        log_info "Aucun serveur en cours d'exécution"
    fi
}

cmd_logs() {
    local log_file="$PROJECT_DIR/server.log"
    
    if [ -f "$log_file" ]; then
        tail -f "$log_file"
    else
        log_error "Fichier de log non trouvé: $log_file"
        exit 1
    fi
}

cmd_test() {
    log_info "Lancement des tests..."
    
    if [ -d "$VENV_DIR" ]; then
        source "$VENV_DIR/bin/activate"
    fi
    
    cd "$PROJECT_DIR"

    if [ ! -d "$PROJECT_DIR/tests" ]; then
        log_error "Répertoire tests/ introuvable"
        exit 1
    fi

    if [ "$#" -gt 0 ]; then
        PYTHONPATH="$PROJECT_DIR/src:$PYTHONPATH" python -m pytest "$@"
    else
        PYTHONPATH="$PROJECT_DIR/src:$PYTHONPATH" python -m pytest tests/
    fi
}

cmd_shell() {
    if [ -d "$VENV_DIR" ]; then
        source "$VENV_DIR/bin/activate"
    fi
    
    cd "$PROJECT_DIR"
    PYTHONPATH="$PROJECT_DIR/src:$PYTHONPATH" python
}

# =============================================================================
# Main
# =============================================================================

main() {
    case "${1:-help}" in
        start)
            shift
            cmd_start "$@"
            ;;
        stop)
            cmd_stop
            ;;
        restart)
            shift
            cmd_restart "$@"
            ;;
        status)
            cmd_status
            ;;
        logs)
            cmd_logs
            ;;
        test)
            shift
            cmd_test "$@"
            ;;
        shell)
            cmd_shell
            ;;
        help|--help|-h)
            show_help
            ;;
        *)
            log_error "Commande inconnue: $1"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
